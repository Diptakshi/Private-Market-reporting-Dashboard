/// Where the CSVs live: the GitHub repo by default, or a local folder path ending with a backslash
expression DataFolder = "https://raw.githubusercontent.com/Diptakshi/Private-Market-reporting-Dashboard/main/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: f3c58aa5-55c9-a9f8-d443-553b72045466

/// Loads a UTF-8 CSV from DataFolder (web or local) and promotes headers
expression fnLoadCsv =
		(fileName as text) as table =>
		let
		    Raw = if Text.StartsWith(DataFolder, "http")
		          then Web.Contents(DataFolder, [RelativePath = fileName])
		          else File.Contents(DataFolder & fileName),
		    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true])
		in
		    Promoted
	lineageTag: 95dbac43-5533-455a-bf03-bea58da96330
